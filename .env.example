DATABASE_URL=postgresql://fabrica:fabrica_local@127.0.0.1:5543/fabrica?connect_timeout=5
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_STYLE=responses
LLM_AUTH_STYLE=api-key
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
BACKLOG_MAX_TOKENS=4096
LLM_TIMEOUT=180
# Modelo específico para la fase de construcción (código real); vacío = usa LLM_MODEL.
CONSTRUCTION_MODEL=
CONSTRUCTION_TIMEOUT=
REWRITE_PROVIDER=openai_compatible
REWRITE_BASE_URL=
REWRITE_MODEL=
REWRITE_API_KEY=
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=
RETRIEVAL_K=12
FINAL_K=5
CHUNK_SIZE=1100
CHUNK_OVERLAP=180
API_TOKEN=
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
LANGGRAPH_STRICT_MSGPACK=true

# Fase 3: presupuesto de salida por llamada, sin modelo adicional
MOCKUP_MAX_TOKENS=6144

# Sol consume parte del presupuesto en razonamiento interno antes del JSON visible;
# con 12000 el agente de pruebas quedaba truncado (status != completed).
CONSTRUCTION_MAX_TOKENS=20000

# Despliegue remoto automático tras aprobar una construcción (opcional).
# Si DEPLOY_REMOTE_ENABLED no está en true, esta función no hace nada: ningún proyecto
# se ve afectado. Requiere que este backend tenga salida SSH real hacia el servidor
# (no funciona desde un entorno sandbox sin red). La clave privada debe existir en esta
# máquina (no se sube al repositorio) y el usuario remoto debe poder ejecutar docker
# compose sin sudo.
DEPLOY_REMOTE_ENABLED=false
DEPLOY_REMOTE_HOST=
DEPLOY_REMOTE_USER=ubuntu
DEPLOY_REMOTE_KEY_PATH=
DEPLOY_REMOTE_BASE_DIR=~/despliegues
DEPLOY_REMOTE_BASE_PORT=8200
