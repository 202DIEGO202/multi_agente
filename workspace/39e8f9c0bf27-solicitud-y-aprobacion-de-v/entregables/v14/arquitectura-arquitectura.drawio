metry x="174" y="630" width="220" height="88" as="geometry"/></mxCell><mxCell id="D" value="&lt;b&gt;La solicitud fue aprobada o rechazada mientras Talento Humano la evaluaba.&lt;/b&gt;&lt;br&gt;Decisión" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="174" y="828" width="220" height="88" as="geometry"/></mxCell><mxCell id="P5" value="&lt;b&gt;Confirma versión y carga datos de la solicitud.&lt;/b&gt;&lt;br&gt;Servicio de revisiones → Repositorio de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="36" y="1026" width="220" height="88" as="geometry"/></mxCell><mxCell id="P6" value="&lt;b&gt;Registra auditoría de acceso y decisión.&lt;/b&gt;&lt;br&gt;Servicio de revisiones → Servicio de auditoría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="36" y="1224" width="220" height="88" as="geometry"/></mxCell><mxCell id="P7" value="&lt;b&gt;Envía la validación/aprobación con observaciones si aplica.&lt;/b&gt;&lt;br&gt;Portal interno de solicitudes → API de gestión de ausencias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="1422" width="220" height="88" as="geometry"/></mxCell><mxCell id="P8" value="&lt;b&gt;Procesa la decisión y actualiza el estado final o intermedio.&lt;/b&gt;&lt;br&gt;API de gestión de ausencias → Controlador de revisiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="1620" width="220" height="88" as="geometry"/></mxCell><mxCell id="P9" value="&lt;b&gt;Dispara la notificación de cambio de estado al empleado.&lt;/b&gt;&lt;br&gt;Servicio de revisiones → Servicio de notificaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeome