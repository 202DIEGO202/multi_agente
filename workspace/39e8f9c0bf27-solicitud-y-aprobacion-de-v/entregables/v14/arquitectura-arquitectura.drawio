yle="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P7" target="P8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P8" target="P9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="D" target="A1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flujo-sq-005" name="Flujo · Administrar tipos de ausencia y flujo de aprobación"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="568" pageHeight="1546"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="P1" value="&lt;b&gt;Accede a la administración del catálogo de tipos de ausencia.&lt;/b&gt;&lt;br&gt;Talento Humano → Portal interno de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="36" width="220" height="88" as="geometry"/></mxCell><mxCell id="P2" value="&lt;b&gt;Solicita listar o modificar tipos de ausencia y su flujo.&lt;/b&gt;&lt;br&gt;Portal interno de solicitudes → API de gestión de ausencias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="234" width="220" height="88" as="geometry"/></mxCell><mxCell id="P3" value="&lt;b&gt;Deriva la operación al controlador de catálogo.&lt;/b&gt;&lt;br&gt;API de gestión de ausencias → Controlador de catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="432" width="220" height="88" as="geometry"/></mxCell><mxCell id="P4" value="&lt;b&gt;Ejecuta crear, actualizar, eliminar o asignar flujo de aprobación.&lt;/b&gt;&lt;br&gt;Controlador de catálogo → Servicio de catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="630" width="220" height="88" as="geometry"/></mxCell><mxCell id="D" value="&lt;b&gt;El cambio invalida una referencia activa o no cumple permisos de administración.&lt;/b&gt;&lt;br&gt;Decisión" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="174" y="828" width="220" height="88" as="geometry"/></mxCell><mxCell id="P5" value="&lt;b&gt;Persiste los cambios del catálogo y la configuración de flujo.&lt;/b&gt;&lt;br&gt;Servicio de catálogo → Repositorio de catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="36" y="1026" width="220" height="88" as="geometry"/></mxCell><mxCell id="P6" value="&lt;b&gt;Registra auditoría de la modificación del catálogo.&lt;/b&gt;&lt;br&gt;Servicio de catálogo → Servicio de auditoría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="36" y="1224" width="220" height="88" as="geometry"/></mxCell><mxCell id="P7" value="&lt;b&gt;Retorna el resultado de la operación.&lt;/b&gt;&lt;br&gt;Controlador de catálogo → Portal interno de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="1422" width="220" height="88" as="geometry"/></mxCell><mxCell id="A1" value="&lt;b&gt;Rechaza la modificación y devuelve error de autorización o validación.&lt;/b&gt;&lt;br&gt;Alternativa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="312" y="1026" width="220" height="88" as="geometry"/></mxCell><mxCell id