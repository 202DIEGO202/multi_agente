=1;html=1;endArrow=block;" edge="1" parent="1" source="IN-006" target="IN-010"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="IN-006" target="IN-011"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="SMTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="IN-006" target="IN-012"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flujo-sq-001" name="Flujo · Registrar solicitud de vacaciones o permiso y consultar su estado"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="568" pageHeight="2140"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="P1" value="&lt;b&gt;Ingresa al formulario de solicitudes y captura tipo de ausencia, fecha&lt;/b&gt;&lt;br&gt;Empleado → Portal interno de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="36" width="220" height="88" as="geometry"/></mxCell><mxCell id="P2" value="&lt;b&gt;Envía la solicitud para validación y creación.&lt;/b&gt;&lt;br&gt;Portal interno de solicitudes → API de gestión de ausencias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="234" width="220" height="88" as="geometry"/></mxCell><mxCell id="P3" value="&lt;b&gt;Recibe la petición y la deriva al servicio de solicitudes.&lt;/b&gt;&lt;br&gt;API de gestión de ausencias → Controlador de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="432" width="220" height="88" as="geometry"/></mxCell><mxCell id="P4" value="&lt;b&gt;Solicita validación de obligatoriedad del motivo/observación según el &lt;/b&gt;&lt;br&gt;Controlador de solicitudes → Servicio de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="630" width="220" height="88" as="geometry"/></mxCell><mxCell id="D" value="&lt;b&gt;La solicitud no cumple la obligatoriedad del motivo/observación o falta un dato requerido.&lt;/b&gt;&lt;br&gt;Decisión" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="174" y="828" width="220" height="88" as="geometry"/></mxCell><mxCell id="P5" value="&lt;b&gt;Persiste la solicitud, su estado inicial y el historial de creación.&lt;/b&gt;&lt;br&gt;Servicio de solicitudes → Repositorio de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="36" y="1026" width="220" height="88" as="geometry"/></mxCell><mxCell id="P6" value="&lt;b&gt;Registra auditoría de creación y, cuando el empleado consulta el histo&lt;/b&gt;&lt;br&gt;Servicio de solicitudes → Servicio de auditoría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="36" y="1224" width="220" height="88" as="geometry"/></mxCell><mxCell id="P7" value="&lt;b&gt;Devuelve confirmación de registro y el identificador para seguimiento.&lt;/b&gt;&lt;br&gt;Controlador de solicitudes → Portal interno de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="1422" width="220" height="88" as="geometry"/></mxCell><mxCell id="P8" value="&lt;b&gt;Consulta el estado e historial de su solicitud.&lt;/b&gt;&lt;br&gt;Empleado → Portal interno de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="1620" width="220" height="88" as="geometry"/></mxCell><mxCell id="P9" value="&lt;b&gt;Solicita el detalle de la solicitud.&lt;/b&gt;&lt;br&gt;Portal interno de solicitudes → API de gestión de ausencias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="1818" width="220" height="88" as="geometry"/></mxCell><mxCell id="P10" value="&lt;b&gt;Consulta el estado, historial y observaciones asociadas.&lt;/b&gt;&lt;br&gt;API de gestión de ausencias → Controlador de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="2016" width="220" height="88" as="geometry"/></mxCell><mxCell id="A1" value="&lt;b&gt;Rechaza la creación con error de validación indicando el campo faltant&lt;/b&gt;&lt;br&gt;Alternativa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="312" y="1026" width="220" height="88" as="geometry"/></mxCell><mxCell id="A2" value="&lt;b&gt;Retorna el mensaje de error para corrección en la UI.&lt;/b&gt;&lt;br&gt;Alternativa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="312" y="1224" width="220" height="88" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P1" target="P2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P2" target="P3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P3" target="P4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P4" target="D"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="D" target="P5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P5" target="P6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P6" target="P7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P7" target="P8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P8" target="P9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P9" target="P10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="D" target="A1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flujo-sq-002" name="Flujo · Notificar cambio de estado y solicitudes pendientes"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="568" pageHeight="952"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="P1" value="&lt;b&gt;Después de aprobar, rechazar o validar, solicita generar notificación &lt;/b&gt;&lt;br&gt;Servicio de revisiones → Servicio de notificaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="36" width="220" height="88" as="geometry"/></mxCell><mxCell id="P2" value="&lt;b&gt;Envía correo al empleado con el nuevo estado y a los aprobadores cuand&lt;/b&gt;&lt;br&gt;Servicio de notificaciones → Integración SMTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="234" width="220" height="88" as="geometry"/></mxCell><mxCell id="D" value="&lt;b&gt;El servidor SMTP no está disponible o rechaza el envío.&lt;/b&gt;&lt;br&gt;Decisión" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="174" y="432" width="220" height="88" as="geometry"/></mxCell><mxCell id="P3" value="&lt;b&gt;Retorna resultado de entrega del correo.&lt;/b&gt;&lt;br&gt;Integración SMTP → Servicio de notificaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="36" y="630" width="220" height="88" as="geometry"/></mxCell><mxCell id="P4" value="&lt;b&gt;Registra auditoría del evento de notificación y su resultado.&lt;/b&gt;&lt;br&gt;Servicio de notificaciones → Servicio de auditoría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="36" y="828" width="220" height="88" as="geometry"/></mxCell><mxCell id="A1" value="&lt;b&gt;Devuelve fallo de envío para reintento o seguimiento operativo.&lt;/b&gt;&lt;br&gt;Alternativa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="312" y="630" width="220" height="88" as="geometry"/></mxCell><mxCell id="A2" value="&lt;b&gt;Registra el intento fallido y el motivo técnico.&lt;/b&gt;&lt;br&gt;Alternativa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="312" y="828" width="220" height="88" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P1" target="P2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P2" target="D"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="D" target="P3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P3" target="P4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="D" target="A1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flujo-sq-003" name="Flujo · Revisar y decidir solicitud como jefe inmediato"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="568" pageHeight="2338"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="P1" value="&lt;b&gt;Accede a la bandeja de revisión.&lt;/b&gt;&lt;br&gt;Jefe inmediato → Portal interno de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="36" width="220" height="88" as="geometry"/></mxCell><mxCell id="P2" value="&lt;b&gt;Consulta solicitudes pendientes de revisión.&lt;/b&gt;&lt;br&gt;Portal interno de solicitudes → API de gestión de ausencias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="234" width="220" height="88" as="geometry"/></mxCell><mxCell id="P3" value="&lt;b&gt;Deriva la consulta al servicio de revisiones.&lt;/b&gt;&lt;br&gt;API de gestión de ausencias → Controlador de revisiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="432" width="220" height="88" as="geometry"/></mxCell><mxCell id="P4" value="&lt;b&gt;Solicita la lista de pendientes del aprobador.&lt;/b&gt;&lt;br&gt;Controlador de revisiones → Servicio de revisiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="630" width="220" height="88" as="geometry"/></mxCell><mxCell id="P5" value="&lt;b&gt;Consulta las solicitudes pendientes asignadas al jefe inmediato.&lt;/b&gt;&lt;br&gt;Servicio de revisiones → Repositorio de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="828" width="220" height="88" as="geometry"/></mxCell><mxCell id="P6" value="&lt;b&gt;Registra auditoría de consulta de bandeja.&lt;/b&gt;&lt;br&gt;Servicio de revisiones → Servicio de auditoría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="1026" width="220" height="88" as="geometry"/></mxCell><mxCell id="P7" value="&lt;b&gt;El jefe inmediato envía decisión de aprobar o rechazar con observación&lt;/b&gt;&lt;br&gt;Portal interno de solicitudes → API de gestión de ausencias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="1224" width="220" height="88" as="geometry"/></mxCell><mxCell id="P8" value="&lt;b&gt;Procesa la decisión mediante control optimista.&lt;/b&gt;&lt;br&gt;API de gestión de ausencias → Controlador de revisiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="1422" width="220" height="88" as="geometry"/></mxCell><mxCell id="D" value="&lt;b&gt;La versión de la solicitud cambió porque otra persona ya la decidió.&lt;/b&gt;&lt;br&gt;Decisión" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="174" y="1620" width="220" height="88" as="geometry"/></mxCell><mxCell id="P9" value="&lt;b&gt;Verifica que la versión no haya cambiado y registra la decisión.&lt;/b&gt;&lt;br&gt;Controlador de revisiones → Servicio de revisiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="36" y="1818" width="220" height="88" as="geometry"/></mxCell><mxCell id="P10" value="&lt;b&gt;Actualiza estado, guarda observación e historial de la decisión.&lt;/b&gt;&lt;br&gt;Servicio de revisiones → Repositorio de solicitudes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="36" y="2016" width="220" height="88" as="geometry"/></mxCell><mxCell id="P11" value="&lt;b&gt;Registra auditoría de la aprobación o rechazo.&lt;/b&gt;&lt;br&gt;Servicio de revisiones → Servicio de auditoría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="2214" width="220" height="88" as="geometry"/></mxCell><mxCell id="A1" value="&lt;b&gt;Rechaza la operación por conflicto de concurrencia.&lt;/b&gt;&lt;br&gt;Alternativa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="312" y="1818" width="220" height="88" as="geometry"/></mxCell><mxCell id="A2" value="&lt;b&gt;Informa que la solicitud ya fue modificada y debe recargarse.&lt;/b&gt;&lt;br&gt;Alternativa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="312" y="2016" width="220" height="88" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P1" target="P2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P2" target="P3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P3" target="P4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P4" target="P5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P5" target="P6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P6" target="P7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P7" target="P8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P8" target="D"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="D" target="P9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P9" target="P10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P1